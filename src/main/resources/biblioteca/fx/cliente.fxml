<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.fx.Controller.clienteController" style="-fx-background-color:#f5f5f5;">
    <top>
        <VBox style="-fx-background-color:#2196F3; -fx-padding:20;">
            <Label text="Biblioteca - Sistema de Gestão" style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;" />
            <Label text="Gerenciar Clientes" style="-fx-text-fill:#e0e0e0; -fx-font-size:13px; -fx-padding:5 0 0 0;" />
        </VBox>
    </top>
    <left>
        <VBox spacing="14">
            <padding>
               <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Informações do Cliente" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333;" />
            <GridPane hgap="12" vgap="10">
                <children>
                    <Label text="Nome:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="nomeClienteField" prefWidth="260" style="-fx-font-size:11px; -fx-padding:6; -fx-border-color:#d0d0d0;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Telefone:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="telefoneField" prefWidth="160" style="-fx-font-size:11px; -fx-padding:6; -fx-border-color:#d0d0d0;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="Email:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="emailField" prefWidth="200" style="-fx-font-size:11px; -fx-padding:6; -fx-border-color:#d0d0d0;" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                </children>
            </GridPane>

            <Label text="Ações" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333; -fx-padding:12 0 0 0;" />
            <VBox spacing="8">
                <Button fx:id="salvarButton" mnemonicParsing="false" onAction="#salvarButton" text="➕ Adicionar" style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="listarButton" mnemonicParsing="false" onAction="#listarButton" text="🔄 Atualizar Lista" style="-fx-background-color:#2196F3; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="atualizarButton" mnemonicParsing="false" onAction="#updateButton" text="✏️ Alterar" style="-fx-background-color:#FF9800; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButton" text="🗑️ Deletar" style="-fx-background-color:#F44336; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="cancelarButton" mnemonicParsing="false" onAction="#cancelarButton" text="❌ Limpar" style="-fx-background-color:#9E9E9E; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="voltarButton" mnemonicParsing="false" onAction="#voltarButton" text="⬅️ Voltar" style="-fx-background-color:#607D8B; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox>
            <padding>
               <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Lista de Clientes" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333; -fx-padding:0 0 10 0;" />
            <TableView fx:id="clienteTableView" prefWidth="480" prefHeight="480" style="-fx-font-size:11px; -fx-table-cell-border-color:#e0e0e0; -fx-control-inner-background:#ffffff;">
                <columns>
                    <TableColumn fx:id="clienteId" prefWidth="50" text="ID" style="-fx-alignment:CENTER;" />
                    <TableColumn fx:id="clienteNome" prefWidth="150" text="Nome" />
                    <TableColumn fx:id="clienteTelefone" prefWidth="140" text="Telefone" style="-fx-alignment:CENTER;" />
                    <TableColumn fx:id="clienteEmail" prefWidth="140" text="Email" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Label text="v1.0 © 2025 Sistema de Biblioteca" style="-fx-text-fill:#999999; -fx-font-size:10px; -fx-padding:12;" alignment="CENTER" />
    </bottom>
</BorderPane>
