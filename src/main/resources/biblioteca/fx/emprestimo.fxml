<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.fx.Controller.emprestimoController" style="-fx-background-color:#f5f5f5;">
    <top>
        <VBox style="-fx-background-color:#F44336; -fx-padding:20;">
            <Label text="Biblioteca - Sistema de Gestão" style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;" />
            <Label text="Gerenciar Empréstimos" style="-fx-text-fill:#e0e0e0; -fx-font-size:13px; -fx-padding:5 0 0 0;" />
        </VBox>
    </top>
    <left>
        <VBox spacing="14">
            <padding>
               <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Informações do Empréstimo" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333;" />
            <GridPane hgap="12" vgap="10">
                <children>
                    <Label text="Cliente:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <ComboBox fx:id="emprestimoComboBox" prefWidth="260" style="-fx-font-size:11px;" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Selecione um cliente" />

                    <Label text="Livro:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <ComboBox fx:id="livroBox" prefWidth="260" style="-fx-font-size:11px;" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Selecione um livro" />

                    <Label text="Data Início:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="inicioField" prefWidth="200" style="-fx-font-size:11px; -fx-padding:6; -fx-border-color:#d0d0d0;" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="DD/MM/YYYY" />

                    <Label text="Data Devolução:" style="-fx-text-fill:#555555; -fx-font-weight:bold;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="fimField" prefWidth="200" style="-fx-font-size:11px; -fx-padding:6; -fx-border-color:#d0d0d0;" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="DD/MM/YYYY" />
                </children>
            </GridPane>

            <Label text="Ações" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333; -fx-padding:12 0 0 0;" />
            <VBox spacing="8">
                <Button fx:id="salvarButton" mnemonicParsing="false" onAction="#salvarButton" text="➕ Adicionar" style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="listarButton" mnemonicParsing="false" onAction="#listarButton" text="🔄 Atualizar Lista" style="-fx-background-color:#F44336; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="atualizarButton" mnemonicParsing="false" onAction="#atualizarButton" text="✏️ Alterar" style="-fx-background-color:#FF9800; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="excluirButton" mnemonicParsing="false" onAction="#excluirButton" text="🗑️ Deletar" style="-fx-background-color:#F44336; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="cancelarButton" mnemonicParsing="false" onAction="#cancelarButton" text="❌ Limpar" style="-fx-background-color:#9E9E9E; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
                <Button fx:id="voltarButton" mnemonicParsing="false" onAction="#voltarButton" text="⬅️ Voltar" style="-fx-background-color:#607D8B; -fx-text-fill:white; -fx-font-size:11px; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-cursor:hand;" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox>
            <padding>
               <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Lista de Empréstimos" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333333; -fx-padding:0 0 10 0;" />
            <TableView fx:id="emprestimoTableView" prefWidth="480" prefHeight="480" style="-fx-font-size:11px; -fx-table-cell-border-color:#e0e0e0; -fx-control-inner-background:#ffffff;">
                <columns>
                    <TableColumn fx:id="emprestimoId" prefWidth="50" text="ID" style="-fx-alignment:CENTER;" />
                    <TableColumn fx:id="emprestimoCliente" prefWidth="110" text="Cliente" />
                    <TableColumn fx:id="emprestimoLivro" prefWidth="110" text="Livro" />
                    <TableColumn fx:id="emprestimoInicio" prefWidth="105" text="Início" style="-fx-alignment:CENTER;" />
                    <TableColumn fx:id="emprestimoFim" prefWidth="105" text="Devolução" style="-fx-alignment:CENTER;" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Label text="v1.0 © 2025 Sistema de Biblioteca" style="-fx-text-fill:#999999; -fx-font-size:10px; -fx-padding:12;" alignment="CENTER" />
    </bottom>
</BorderPane>

