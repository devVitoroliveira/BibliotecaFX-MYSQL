<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.fx.Controller.connectController" prefWidth="650" prefHeight="450" style="-fx-background-color:#f5f5f5;">
    <top>
        <VBox style="-fx-background-color:#2b6ea3; -fx-padding:20;">
            <Label text="Biblioteca - Sistema de Gestão" style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;" />
            <Label text="Autenticação" style="-fx-text-fill:#e0e0e0; -fx-font-size:13px; -fx-padding:5 0 0 0;" />
        </VBox>
    </top>
    <center>
        <VBox spacing="16" alignment="CENTER">
            <padding>
               <Insets top="40" right="60" bottom="40" left="60" />
            </padding>
            <Label text="Credenciais de Acesso" style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333333;" />
            <VBox spacing="6">
                <Label text="Usuário" style="-fx-text-fill:#555555; -fx-font-size:11px; -fx-font-weight:bold;" />
                <TextField fx:id="user" prefHeight="36" prefWidth="280" style="-fx-font-size:12px; -fx-padding:8; -fx-border-color:#d0d0d0; -fx-border-radius:4; -fx-control-inner-background:#ffffff;" promptText="Digite seu usuário" />
            </VBox>
            <VBox spacing="6">
                <Label text="Senha" style="-fx-text-fill:#555555; -fx-font-size:11px; -fx-font-weight:bold;" />
                <PasswordField fx:id="password" prefHeight="36" prefWidth="280" style="-fx-font-size:12px; -fx-padding:8; -fx-border-color:#d0d0d0; -fx-border-radius:4; -fx-control-inner-background:#ffffff;" promptText="Digite sua senha" />
            </VBox>
            <HBox spacing="10" style="-fx-padding:20 0 0 0;" alignment="CENTER">
                <Button fx:id="btnConnect" mnemonicParsing="false" onAction="#login" text="Iniciar Sessão" style="-fx-background-color:#2b6ea3; -fx-text-fill:white; -fx-font-size:12px; -fx-font-weight:bold; -fx-padding:10 40 10 40; -fx-cursor:hand;" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <Label text="v1.0 © 2025 Sistema de Biblioteca" style="-fx-text-fill:#999999; -fx-font-size:10px; -fx-padding:12;" alignment="CENTER" />
    </bottom>
</BorderPane>

