<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.fx.Controller.mainController" style="-fx-background-color:#f5f5f5;">
    <top>
        <VBox style="-fx-background-color:#2b6ea3; -fx-padding:20;">
            <Label text="Biblioteca - Sistema de Gestão" style="-fx-text-fill:white; -fx-font-size:24px; -fx-font-weight:bold;" />
            <Label text="Menu Principal - Selecione uma opção" style="-fx-text-fill:#e0e0e0; -fx-font-size:12px; -fx-padding:8 0 0 0;" />
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER">
            <padding>
               <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <GridPane hgap="20" vgap="20" alignment="CENTER">
                <Button fx:id="autor" text="📚 Gerenciar Autores" style="-fx-font-size:14px; -fx-padding:20 30 20 30; -fx-background-color:#4CAF50; -fx-text-fill:white; -fx-cursor:hand;" mnemonicParsing="false" onAction="#abrirTelaAutor" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Button fx:id="cliente" text="👤 Gerenciar Clientes" style="-fx-font-size:14px; -fx-padding:20 30 20 30; -fx-background-color:#2196F3; -fx-text-fill:white; -fx-cursor:hand;" mnemonicParsing="false" onAction="#abrirTelaCliente" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Button fx:id="func" text="💼 Gerenciar Funcionários" style="-fx-font-size:14px; -fx-padding:20 30 20 30; -fx-background-color:#FF9800; -fx-text-fill:white; -fx-cursor:hand;" mnemonicParsing="false" onAction="#abrirTelaFuncionario" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Button fx:id="livroButton" text="📖 Gerenciar Livros" style="-fx-font-size:14px; -fx-padding:20 30 20 30; -fx-background-color:#9C27B0; -fx-text-fill:white; -fx-cursor:hand;" mnemonicParsing="false" onAction="#abrirTelaLivro" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Button fx:id="emprestimoButton" text="🔄 Gerenciar Empréstimos" style="-fx-font-size:14px; -fx-padding:20 30 20 30; -fx-background-color:#F44336; -fx-text-fill:white; -fx-cursor:hand;" mnemonicParsing="false" onAction="#abrirTelaEmp" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2" />
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <Label text="v1.0 © 2025 Sistema de Biblioteca - Todos os direitos reservados" style="-fx-text-fill:#999999; -fx-font-size:10px; -fx-padding:12;" alignment="CENTER" />
    </bottom>
</BorderPane>
